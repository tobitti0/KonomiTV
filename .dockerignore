
# config.yaml: ホスト側のファイルを利用するため不要
config.yaml

# Box の資格情報: Docker イメージには含めず、実行時に Docker Secret としてマウントする
box-credentials.json

# ローカル専用テスト・実ファイル検証: 必要な場合だけ明示的に bind mount する
Test/

# node_modules: ファイル数が多すぎてコピーに時間がかかる
client/node_modules/

# poetry の仮想環境: Docker 上で新たに作り直すため不要
server/.venv/

# データベース: マイグレーションに失敗するのを防ぐ
server/data/*

# 実行時ログ: bind mount するため Docker イメージには含めない
server/logs/*
!server/logs/.gitkeep

# サードパーティーライブラリ: Docker 側でファイルを準備するため不要
server/thirdparty/
